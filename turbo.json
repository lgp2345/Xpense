{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "check": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:reset-rental-billing": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL"
      ]
    },
    "@xpense/server#test": {
      "dependsOn": [
        "build"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "RENTAL_MIGRATION_TEST_DATABASE_URL",
        "RENTAL_FINANCE_TEST_DDL_APPROVED"
      ]
    },
    "db:seed-rental-period-billing": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL"
      ],
      "dependsOn": [
        "build"
      ]
    }
  }
}
