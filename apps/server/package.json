{
  "name": "@xpense/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "if [ -f ../../.env ]; then dotenv -e ../../.env -- drizzle-kit migrate; else drizzle-kit migrate; fi",
    "db:prepare": "pnpm db:migrate && pnpm db:seed:rbac",
    "db:push": "if [ -f ../../.env ]; then dotenv -e ../../.env -- drizzle-kit push; else drizzle-kit push; fi",
    "db:seed:rbac": "if [ -f ../../.env ]; then dotenv -e ../../.env -- tsx src/db/seed-rbac.ts; else tsx src/db/seed-rbac.ts; fi",
    "dev": "dotenv -e ../../.env -- nest start --watch --exec tsx",
    "lint": "biome check src",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-fastify": "^11.1.9",
    "@xpense/shared": "workspace:*",
    "argon2": "^0.44.0",
    "drizzle-orm": "1.0.0-rc.4",
    "jose": "^6.2.3",
    "nanoid": "^5.1.16",
    "nestjs-zod": "^5.0.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "svg-captcha": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.9",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "1.0.0-rc.3",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
